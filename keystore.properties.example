# 复制为 keystore.properties 后填入真实值（该文件已被 .gitignore 忽略）
#
# 生成密钥库：
#   keytool -genkeypair -v -keystore keystore/lpdf-release.jks \
#     -alias lpdf -keyalg RSA -keysize 4096 -validity 10950
#
# CI 环境请改用同名环境变量，避免口令落到文件里：
#   LPdf_KEYSTORE_PATH / LPdf_KEYSTORE_PASSWORD / LPdf_KEY_ALIAS / LPdf_KEY_PASSWORD

storeFile=keystore/lpdf-release.jks
storePassword=__CHANGE_ME__
keyAlias=lpdf
keyPassword=__CHANGE_ME__
